#: xbmc/settings/SevicesSettings.cpp
msgctxt "#37111"
msgid "Only buffer true internet streams: HTTP, HTTPS, etc."
msgstr "Maolán ach fíor-sruthanna idirlín: HTTP, HTTPS, srl."

#. Value of setting - INTERNET
